{
  "info": {
    "name": "Ecommerce sample",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [{ "key": "baseUrl", "value": "http://127.0.0.1:4010" }],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Catalog",
      "item": [
        {
          "name": "List products",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/products?page=1"
          }
        },
        {
          "name": "Create product",
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('created', () => pm.response.code === 201);"] }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"name\":\"Widget\",\"price\":9.99}" },
            "url": "{{baseUrl}}/products"
          }
        }
      ]
    }
  ]
}
