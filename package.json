{
  "name": "ai-k6-performance-agent",
  "version": "0.2.0",
  "description": "Open-source AI-powered performance engineering framework that converts API definitions into executable k6 tests and explains the results.",
  "type": "module",
  "bin": {
    "k6-agent": "./dist/cli/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "prompts",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli/index.js",
    "k6-agent": "node dist/cli/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "mock-api": "node dist/mock-api/server.js"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "k6",
    "performance-testing",
    "openapi",
    "load-testing",
    "ai-agent"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/example/ai-k6-performance-agent"
  },
  "dependencies": {
    "commander": "^13.1.0",
    "dotenv": "^16.4.7",
    "picocolors": "^1.1.1",
    "prompts": "^2.4.2",
    "yaml": "^2.7.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/node": "^22.13.9",
    "@types/prompts": "^2.4.9",
    "eslint": "^9.21.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.0",
    "vitest": "^3.0.7"
  }
}
